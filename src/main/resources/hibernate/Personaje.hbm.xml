<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="ar.edu.unq.epers.unidad4.model">

    <class name="Personaje" table="personaje">
        
        <id name="id" column="id">
            <generator class="identity"/>
        </id>

        <property name="nombre" column="nombre" not-null="true" unique="true" length="500"/>
        <property name="vida" column="vida" not-null="true"/>
        <property name="pesoMaximo" column="peso_maximo" not-null="true"/>

        <set name="inventario" cascade="all" fetch="join" lazy="false">
            <key column="owner_id"/>
            <one-to-many class="Item"/>
        </set>

    </class>

</hibernate-mapping>

